# Copy to .env.local. Never commit real values; keep them in ~/.config/nebius-cli/accounts.ini (chmod 600) and in Vercel env.

# Nebius Token Factory (https://tokenfactory.nebius.com). Without it every route serves recorded replays.
NEBIUS_API_KEY=

# The four NVIDIA models, overridable so a renamed model does not break the demo in December.
UNDERSTUDY_MODEL_VL=nvidia/Nemotron-3.5-Super-VL
UNDERSTUDY_MODEL_NANO=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
UNDERSTUDY_MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
UNDERSTUDY_MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b

# Tavily (https://tavily.com), optional: grounds hazards and preconditions with URLs.
TAVILY_API_KEY=

# Uploads of your own clips need this code; the sample clips run without it.
UNDERSTUDY_UNLOCK_CODE=

# Label input: "video" (default; a 480p 4 fps proxy of the clip as a data URI, measured 23 Oct) or "keyframes" (7 keyframes plus a montage, the fallback).
UNDERSTUDY_LABEL_INPUT=video
